# Supabase — pegue esses valores em Project Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Somente para uso em Server Actions/Route Handlers que precisem bypassar RLS
# (ex.: criação manual de usuários admin). NUNCA exponha esta chave no
# cliente (sem prefixo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
